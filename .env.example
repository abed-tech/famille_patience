# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=changez-moi-avec-une-cle-longue-et-aleatoire
DEBUG=False

# Hôtes (ajoutez votre domaine Render)
ALLOWED_HOSTS=votre-app.onrender.com,localhost
CSRF_TRUSTED_ORIGINS=https://votre-app.onrender.com
CORS_ALLOWED_ORIGINS=https://votre-app.onrender.com

# Base de données (Render injecte DATABASE_URL automatiquement)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis (Upstash gratuit recommandé pour cache + WebSocket)
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary — stockage externe des photos (OBLIGATOIRE en production Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Développement local uniquement
# USE_SQLITE=true
# DJANGO_SETTINGS_MODULE=config.settings.development
