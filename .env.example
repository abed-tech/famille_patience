# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=changez-moi-avec-une-cle-longue-et-aleatoire
DEBUG=False

# Hôtes (ajoutez votre domaine Render)
ALLOWED_HOSTS=votre-app.onrender.com,localhost
CSRF_TRUSTED_ORIGINS=https://votre-app.onrender.com
CORS_ALLOWED_ORIGINS=https://votre-app.onrender.com

# Base de données (Render injecte DATABASE_URL automatiquement)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Redis / Upstash (cache, sessions, Channels, Celery)
# REST — obligatoire pour Upstash (ne jamais committer les vraies valeurs)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
# Natif — onglet « Redis Connect » du dashboard Upstash (rediss://...)
UPSTASH_REDIS_URL=rediss://default:password@your-database.upstash.io:6379
# Alias optionnel (priorité égale à UPSTASH_REDIS_URL)
# REDIS_URL=rediss://default:password@your-database.upstash.io:6379

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudinary — stockage externe des photos (OBLIGATOIRE en production Render)
# Option recommandée : une seule variable (ne jamais committer la vraie URL)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option alternative : variables séparées
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Admin auto au déploiement (Render Build → bootstrap_prod) — ne jamais committer le vrai mot de passe
# CREATE_SUPERUSER_EMAIL=admin@example.com
# CREATE_SUPERUSER_PASSWORD=votre-mot-de-passe-fort
# BOOTSTRAP_SEED_DATA=true

# Développement local uniquement
# USE_SQLITE=true
# DJANGO_SETTINGS_MODULE=config.settings.development
